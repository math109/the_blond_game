config_version=5

[application]

config/name="The Blonde"
config/description="Chame três vezes. Desta vez, alguém responde."
run/main_scene="res://cenas/fases/teste_corredor.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Medo="*uid://vkhgux8t2ya4"
Historia="*uid://qgfnnx3epbpo"
Dialogo="*res://cenas/ui/caixa_dialogo.tscn"
Inventory="*uid://odydhlnqcjod"
Avisos="*res://cenas/ui/avisos.tscn"
Celular="*uid://ho46jxlhg18r"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

